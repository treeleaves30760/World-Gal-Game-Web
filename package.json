{
  "name": "world-gal-game-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Website and documentation for the World Gal-Game engine (VitePress)",
  "scripts": {
    "sync-docs": "node scripts/sync-docs.mjs",
    "dev": "npm run sync-docs && vitepress dev",
    "build": "npm run sync-docs && vitepress build",
    "preview": "vitepress preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "vitepress": "1.6.4",
    "vue": "3.5.22",
    "wrangler": "4.151.3"
  },
  "engines": {
    "node": ">=20.0"
  }
}
